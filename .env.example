APIFREE_API_KEY=              # API key from https://www.apifree.ai/dashboard
APIFREE_BASE_URL=https://api.apifree.ai/v1
DATABASE_URL=postgresql://videogen:changeme@postgres:5432/videogen
REDIS_URL=redis://redis:6379
ENCRYPTION_KEY=               # 32 hex chars: openssl rand -hex 16
STORAGE_TYPE=local            # local | s3
STORAGE_PATH=/app/storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=                  # For R2, MinIO etc.
S3_ACCESS_KEY=
S3_SECRET_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=production
PORT=3000
POSTGRES_PASSWORD=changeme
MOCK_MODE=false               # Set true for development without API key
AUTH_USERNAME=admin            # Login username (leave empty to disable auth)
AUTH_PASSWORD=                 # Login password (leave empty to disable auth)
